# Require a verified SMS/email code after password sign-in for users with a
# confirmed mobile number. Set to false only for an authorised OTP outage.
LOGIN_OTP_ENABLED=true

# Which route the FIRST sign-in code takes: 'sms' (the config default) or
# 'email'. Accounts with no real email address receive an SMS either way, and
# the sign-in screen always offers the other route.
#
# Reverted to 'sms' on 2026-09-28 on request: codes had been switched to email
# and were expected by SMS. NOTE this does not cover 19:45-08:00 -- the telcos
# hold promotional SMS overnight, so login_otp.quiet_hours_email_first still
# sends the first code by email in that window. See config/phone_verification.php.
LOGIN_OTP_CHANNEL=sms



REGISTRY_SOURCE_BASE_PATH=F:\\storage\\app\\public\\EDMS\\UPLOAD

# Raw scans kept on the records server (10.50.1.1), read over the LAN for File
# Archive page restores. Forward slashes on purpose: dotenv passes an unquoted
# value through verbatim, so backslashes here would reach PHP doubled and the
# UNC path would not resolve. PHP accepts this form and realpath()s it back to
# \\10.50.1.1\LAND_REGISTRY_RAW.
#
# Apache must keep running as an account that can reach the share. It runs as
# klaes\Administrator today; installed as a service under LocalSystem it would
# lose access and every restore would report the folder unavailable.
ARCHIVE_SCANS_FOLDER=//10.50.1.1/land_registry_raw
# Large-format scans for Page Typing / Scan Upload "Add LF Scan" and
# "Replace with LF Scan". Same share rules and slash form as above.
MASTER_LFS_FOLDER=//10.50.1.1/backup/LargeFormatImages
