<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RDS System Testing</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gray-100 p-8">
    <div class="max-w-6xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
            <h1 class="text-3xl font-bold mb-2">RDS (Registered Document Sheet) System Testing</h1>
            <p class="text-gray-600 mb-4">Test all RDS functionality</p>
            <div class="bg-blue-50 border-l-4 border-blue-500 p-4">
                <p class="text-sm"><strong>Base URL:</strong> <span id="baseUrl" class="font-mono"></span></p>
            </div>
        </div>

        <!-- Test Status -->
        <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
            <h2 class="text-xl font-bold mb-4">Test Results</h2>
            <div id="testResults" class="space-y-2">
                <p class="text-gray-500">Run tests to see results...</p>
            </div>
        </div>

        <!-- Test Controls -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Test 1: Generate RDS -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-bold mb-4 text-purple-600">1. Generate RDS</h3>
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium mb-1">Instrument ID:</label>
                        <input type="number" id="generateInstrumentId" class="w-full border rounded px-3 py-2" placeholder="Enter instrument ID" value="1">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">STM Reference:</label>
                        <input type="text" id="generateStmRef" class="w-full border rounded px-3 py-2" placeholder="e.g., STM-2025-0001" value="STM-2025-0001">
                    </div>
                    <button onclick="testGenerateRDS()" class="w-full bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700">
                        Generate RDS
                    </button>
                </div>
            </div>

            <!-- Test 2: View RDS -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-bold mb-4 text-indigo-600">2. View RDS</h3>
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium mb-1">Instrument ID:</label>
                        <input type="number" id="viewInstrumentId" class="w-full border rounded px-3 py-2" placeholder="Enter instrument ID" value="1">
                    </div>
                    <button onclick="testViewRDS()" class="w-full bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700">
                        View RDS
                    </button>
                </div>
            </div>

            <!-- Test 3: Get RDS Status -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-bold mb-4 text-blue-600">3. Get RDS Status</h3>
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium mb-1">Instrument ID:</label>
                        <input type="number" id="statusInstrumentId" class="w-full border rounded px-3 py-2" placeholder="Enter instrument ID" value="1">
                    </div>
                    <button onclick="testGetRDSStatus()" class="w-full bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                        Get Status
                    </button>
                </div>
            </div>

            <!-- Test 4: List RDS -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-bold mb-4 text-green-600">4. List RDS Records</h3>
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium mb-1">Status Filter (optional):</label>
                        <select id="listStatus" class="w-full border rounded px-3 py-2">
                            <option value="">All</option>
                            <option value="generated">Generated</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Per Page:</label>
                        <input type="number" id="listPerPage" class="w-full border rounded px-3 py-2" value="10">
                    </div>
                    <button onclick="testListRDS()" class="w-full bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                        List RDS
                    </button>
                </div>
            </div>

            <!-- Test 5: Delete RDS -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-bold mb-4 text-red-600">5. Delete/Cancel RDS (Admin Only)</h3>
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium mb-1">Instrument ID:</label>
                        <input type="number" id="deleteInstrumentId" class="w-full border rounded px-3 py-2" placeholder="Enter instrument ID" value="1">
                    </div>
                    <div class="bg-red-50 border border-red-200 rounded p-2 text-xs text-red-600">
                        ⚠️ Admin permission required
                    </div>
                    <button onclick="testDeleteRDS()" class="w-full bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">
                        Delete RDS
                    </button>
                </div>
            </div>

            <!-- Test 6: Print RDS -->
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-bold mb-4 text-teal-600">6. Open Print Template</h3>
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium mb-1">Instrument ID:</label>
                        <input type="number" id="printInstrumentId" class="w-full border rounded px-3 py-2" placeholder="Enter instrument ID" value="1">
                    </div>
                    <button onclick="testPrintRDS()" class="w-full bg-teal-600 text-white px-4 py-2 rounded hover:bg-teal-700">
                        Open Print Template
                    </button>
                </div>
            </div>
        </div>

        <!-- Database Check -->
        <div class="bg-white rounded-lg shadow-lg p-6 mt-6">
            <h2 class="text-xl font-bold mb-4">Database Verification</h2>
            <div class="bg-gray-50 p-4 rounded font-mono text-sm space-y-2">
                <p><strong>Check if table exists:</strong></p>
                <code class="block bg-gray-800 text-green-400 p-3 rounded">
                    SELECT * FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'rds_tracking';
                </code>
                
                <p class="mt-4"><strong>View RDS records:</strong></p>
                <code class="block bg-gray-800 text-green-400 p-3 rounded">
                    SELECT TOP 10 * FROM rds_tracking ORDER BY generated_at DESC;
                </code>
                
                <p class="mt-4"><strong>Count RDS by status:</strong></p>
                <code class="block bg-gray-800 text-green-400 p-3 rounded">
                    SELECT status, COUNT(*) as count FROM rds_tracking GROUP BY status;
                </code>
            </div>
        </div>

        <!-- Documentation -->
        <div class="bg-white rounded-lg shadow-lg p-6 mt-6">
            <h2 class="text-xl font-bold mb-4">Implementation Documentation</h2>
            <ul class="space-y-2 text-sm">
                <li>📄 <strong>Controller:</strong> <code class="bg-gray-100 px-2 py-1 rounded">app/Http/Controllers/RDSController.php</code></li>
                <li>📄 <strong>Migration:</strong> <code class="bg-gray-100 px-2 py-1 rounded">database/migrations/2025_10_14_000001_create_rds_tracking_table.php</code></li>
                <li>📄 <strong>Print Template:</strong> <code class="bg-gray-100 px-2 py-1 rounded">resources/views/instrument_registration/rds/print.blade.php</code></li>
                <li>📄 <strong>Routes:</strong> <code class="bg-gray-100 px-2 py-1 rounded">routes/apps2.php</code></li>
                <li>📄 <strong>Frontend:</strong> <code class="bg-gray-100 px-2 py-1 rounded">resources/views/instrument_registration/index.blade.php</code></li>
                <li>📄 <strong>Docs:</strong> <code class="bg-gray-100 px-2 py-1 rounded">RDS_IMPLEMENTATION_COMPLETE.md</code></li>
            </ul>
        </div>
    </div>

    <script>
        // Set base URL
        const baseUrl = window.location.origin;
        document.getElementById('baseUrl').textContent = baseUrl;

        // Get CSRF token (you'll need to set this from your Laravel app)
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || 'TOKEN_NOT_SET';

        function addTestResult(title, success, message, data = null) {
            const resultsDiv = document.getElementById('testResults');
            if (resultsDiv.querySelector('.text-gray-500')) {
                resultsDiv.innerHTML = '';
            }
            
            const resultDiv = document.createElement('div');
            resultDiv.className = `border-l-4 ${success ? 'border-green-500 bg-green-50' : 'border-red-500 bg-red-50'} p-3 rounded`;
            
            let html = `
                <div class="flex items-start">
                    <span class="text-2xl mr-2">${success ? '✅' : '❌'}</span>
                    <div class="flex-1">
                        <p class="font-bold">${title}</p>
                        <p class="text-sm">${message}</p>
                        ${data ? `<pre class="mt-2 text-xs bg-gray-800 text-green-400 p-2 rounded overflow-x-auto">${JSON.stringify(data, null, 2)}</pre>` : ''}
                    </div>
                </div>
            `;
            
            resultDiv.innerHTML = html;
            resultsDiv.insertBefore(resultDiv, resultsDiv.firstChild);
        }

        async function testGenerateRDS() {
            const instrumentId = document.getElementById('generateInstrumentId').value;
            const stmRef = document.getElementById('generateStmRef').value;
            
            if (!instrumentId) {
                Swal.fire('Error', 'Please enter an instrument ID', 'error');
                return;
            }

            Swal.fire({
                title: 'Generating RDS...',
                text: 'Please wait',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            try {
                const response = await fetch(`${baseUrl}/instrument_registration/generate-rds/${instrumentId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: JSON.stringify({ stm_ref: stmRef })
                });

                const data = await response.json();
                Swal.close();

                if (data.success) {
                    addTestResult('Generate RDS', true, data.message, data);
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: `RDS generated: ${data.rds_reference}`,
                        confirmButtonText: 'View RDS'
                    }).then((result) => {
                        if (result.isConfirmed && data.rds_url) {
                            window.open(data.rds_url, '_blank');
                        }
                    });
                } else {
                    addTestResult('Generate RDS', false, data.error || 'Failed to generate RDS', data);
                    Swal.fire('Error', data.error || 'Failed to generate RDS', 'error');
                }
            } catch (error) {
                Swal.close();
                addTestResult('Generate RDS', false, error.message, { error: error.toString() });
                Swal.fire('Error', 'Network error: ' + error.message, 'error');
            }
        }

        async function testViewRDS() {
            const instrumentId = document.getElementById('viewInstrumentId').value;
            
            if (!instrumentId) {
                Swal.fire('Error', 'Please enter an instrument ID', 'error');
                return;
            }

            Swal.fire({
                title: 'Loading RDS...',
                text: 'Please wait',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            try {
                const response = await fetch(`${baseUrl}/instrument_registration/view-rds/${instrumentId}`);
                const data = await response.json();
                Swal.close();

                if (data.success && data.rds_url) {
                    addTestResult('View RDS', true, 'RDS loaded successfully', data);
                    window.open(data.rds_url, '_blank');
                } else {
                    addTestResult('View RDS', false, data.message || 'RDS not found', data);
                    Swal.fire({
                        icon: 'warning',
                        title: 'RDS Not Found',
                        text: data.message || 'RDS has not been generated yet',
                        confirmButtonText: 'OK'
                    });
                }
            } catch (error) {
                Swal.close();
                addTestResult('View RDS', false, error.message, { error: error.toString() });
                Swal.fire('Error', 'Network error: ' + error.message, 'error');
            }
        }

        async function testGetRDSStatus() {
            const instrumentId = document.getElementById('statusInstrumentId').value;
            
            if (!instrumentId) {
                Swal.fire('Error', 'Please enter an instrument ID', 'error');
                return;
            }

            try {
                const response = await fetch(`${baseUrl}/instrument_registration/rds-status/${instrumentId}`);
                const data = await response.json();

                if (data.success) {
                    addTestResult('Get RDS Status', true, 
                        data.exists ? `RDS exists: ${data.rds.rds_reference}` : 'RDS not generated', 
                        data
                    );
                    Swal.fire('Success', JSON.stringify(data, null, 2), 'success');
                } else {
                    addTestResult('Get RDS Status', false, 'Failed to get status', data);
                    Swal.fire('Error', 'Failed to get RDS status', 'error');
                }
            } catch (error) {
                addTestResult('Get RDS Status', false, error.message, { error: error.toString() });
                Swal.fire('Error', 'Network error: ' + error.message, 'error');
            }
        }

        async function testListRDS() {
            const status = document.getElementById('listStatus').value;
            const perPage = document.getElementById('listPerPage').value;
            
            let url = `${baseUrl}/instrument_registration/list-rds?per_page=${perPage}`;
            if (status) url += `&status=${status}`;

            try {
                const response = await fetch(url);
                const data = await response.json();

                if (data.success) {
                    const count = data.data.data ? data.data.data.length : 0;
                    addTestResult('List RDS', true, `Found ${count} records`, data);
                    Swal.fire('Success', `Found ${count} RDS records`, 'success');
                } else {
                    addTestResult('List RDS', false, 'Failed to list RDS', data);
                    Swal.fire('Error', 'Failed to list RDS', 'error');
                }
            } catch (error) {
                addTestResult('List RDS', false, error.message, { error: error.toString() });
                Swal.fire('Error', 'Network error: ' + error.message, 'error');
            }
        }

        async function testDeleteRDS() {
            const instrumentId = document.getElementById('deleteInstrumentId').value;
            
            if (!instrumentId) {
                Swal.fire('Error', 'Please enter an instrument ID', 'error');
                return;
            }

            const confirmed = await Swal.fire({
                title: 'Are you sure?',
                text: 'This will cancel the RDS (admin only)',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, cancel it'
            });

            if (!confirmed.isConfirmed) return;

            try {
                const response = await fetch(`${baseUrl}/instrument_registration/delete-rds/${instrumentId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    }
                });

                const data = await response.json();

                if (data.success) {
                    addTestResult('Delete RDS', true, data.message, data);
                    Swal.fire('Success', data.message, 'success');
                } else {
                    addTestResult('Delete RDS', false, data.error || 'Failed to delete RDS', data);
                    Swal.fire('Error', data.error || 'Failed to delete RDS', 'error');
                }
            } catch (error) {
                addTestResult('Delete RDS', false, error.message, { error: error.toString() });
                Swal.fire('Error', 'Network error: ' + error.message, 'error');
            }
        }

        function testPrintRDS() {
            const instrumentId = document.getElementById('printInstrumentId').value;
            
            if (!instrumentId) {
                Swal.fire('Error', 'Please enter an instrument ID', 'error');
                return;
            }

            const url = `${baseUrl}/instrument_registration/print-rds/${instrumentId}`;
            addTestResult('Open Print Template', true, `Opening: ${url}`, { url });
            window.open(url, '_blank');
        }

        // Show initial message
        addTestResult('System Ready', true, 'RDS testing page loaded. Run tests above.', {
            baseUrl,
            csrfToken: csrfToken === 'TOKEN_NOT_SET' ? 'Not set (open from Laravel app)' : 'Set'
        });
    </script>
</body>
</html>
