@php
    $securityCode = app(\App\Services\SecurityCodeService::class)->getOrGenerateForDocument(
        (string) ($recommendation->file_number ?? ($recommendation->id ?? '')),
        (int) $recommendation->id,
        'Land Conversion'
    );
