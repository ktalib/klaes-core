    function buildCustomOfficeCode(label = '') {
        const normalized = label
            .toString()
            .trim()
            .toUpperCase()
            .replace(/[^A-Z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');

        if (!normalized) {
            return 'CUSTOM';
        }

        const truncated = normalized.length > 20
            ? normalized.substring(0, 20)
            : normalized;

        return truncated.startsWith('CUSTOM') ? truncated : `CUSTOM-${truncated}`;
    }

