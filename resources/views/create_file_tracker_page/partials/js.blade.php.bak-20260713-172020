        const escHtml = s => (s == null ? '' : String(s)).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

        fetch('{{ route('create-file-tracker.file-requesters') }}?file_number=' + encodeURIComponent(fileNumber), { headers: { 'Accept': 'application/json' } })
